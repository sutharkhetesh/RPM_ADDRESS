{
  "name": "addressly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json *.mjs README.md",
    "db:check": "node scripts/check-database.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.68.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
